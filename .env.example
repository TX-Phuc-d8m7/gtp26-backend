# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=food_ai_db

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Startup data sync
RUN_SEED_ON_STARTUP=false
SYNC_TAGS_ON_STARTUP=false
SYNC_FOODS_ON_STARTUP=false
RUN_EMBEDDING_ON_STARTUP=false

# Embedding backfill controls
# 0 means no limit.
EMBEDDING_BACKFILL_LIMIT=0
EMBEDDING_BACKFILL_SLEEP_SECONDS=3

