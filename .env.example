# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=food_ai_db

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Startup data sync
RUN_SEED_ON_STARTUP=false
SYNC_TAGS_ON_STARTUP=false
SYNC_FOODS_ON_STARTUP=false
RUN_EMBEDDING_ON_STARTUP=false

# Embedding backfill controls
# 0 means no limit.
EMBEDDING_BACKFILL_LIMIT=0
EMBEDDING_BACKFILL_SLEEP_SECONDS=3

# Search pipeline rollout
# legacy | semantic_first
SEARCH_PIPELINE_VERSION=legacy
SEMANTIC_RETRIEVAL_TOP_K=100
SEMANTIC_MIN_SCORE=0.0
SEARCH_RETURN_LIMIT=5

# Gemini
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# Places search
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
PLACES_CACHE_TTL_DAYS=7
